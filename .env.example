NODE_ENV=development
# 127.0.0.1 locally; 0.0.0.0 in production so the host's proxy can reach the API.
HOST=127.0.0.1
# If unset, the API uses PORT (set by Render), then 4000. Don't set API_PORT on Render.
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
# The API's origin as the browser sees it, for live updates (Socket.IO connects straight to the API).
# Public: inlined into the browser bundle at build time. Unset = live updates off, pages work as before.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Local infrastructure (docker-compose.yml). Local-only placeholder values.
POSTGRES_USER=diffcraft
POSTGRES_PASSWORD=diffcraft
POSTGRES_DB=diffcraft
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://diffcraft:diffcraft@localhost:5432/diffcraft
# Maximum open Postgres connections per API instance.
DB_POOL_MAX=10
# Production only: proxy addresses to trust for X-Forwarded-For (client IPs): IPs, CIDRs or
# presets (loopback, linklocal, uniquelocal). Render's proxy connects from a private address.
TRUST_PROXY=uniquelocal
# Shared by the web server and the API (same value in both). The web server forwards the client IP
# with it, so per-IP rate limits see real users instead of the web server. At least 32 characters
# (openssl rand -base64 32). Required in production while rate limiting is on; optional locally.
# A secret: never commit a real value.
WEB_PROXY_SECRET=

# Rate limits, counted in Redis and shared by all API instances. false turns them all off.
RATE_LIMIT_ENABLED=true
# Redis key prefix: give each environment that shares one Redis its own.
RATE_LIMIT_PREFIX=diffcraft:rl:
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_EMAIL_PER_15_MINUTES=5
RATE_LIMIT_REGISTER_PER_IP_PER_HOUR=5
RATE_LIMIT_RESEND_PER_USER_PER_HOUR=5
RATE_LIMIT_TICKET_PER_USER_PER_MINUTE=30
RATE_LIMIT_ANALYSIS_PER_USER_PER_MINUTE=5
RATE_LIMIT_COMMENTS_PER_USER_PER_MINUTE=60
# Used only by tests (migrated automatically before the API tests run). Never point it at a real database.
TEST_DATABASE_URL=postgresql://diffcraft:diffcraft@localhost:5432/diffcraft_test
# Redis for the API (realtime tickets, Socket.IO adapter, /ready). Required in production.
REDIS_URL=redis://localhost:6379
# Used only by tests; database 1 keeps test keys apart from development.
TEST_REDIS_URL=redis://localhost:6379/1

# Email. smtp (default) sends through MAIL_SMTP_URL; locally that is Mailpit from docker-compose.yml
# (inbox at http://localhost:8025). log writes each email, link included, to the API log instead:
# only for environments without an email provider. Production with smtp must set both MAIL_* values.
MAIL_TRANSPORT=smtp
MAIL_SMTP_URL=smtp://localhost:1025
MAIL_FROM=DiffCraft <noreply@localhost>
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# AI review. fake (default outside production) returns example findings with no network call;
# disabled turns the feature off (POST …/analyses answers 503); openai_compatible calls any
# OpenAI-compatible chat completions API. Production must set AI_PROVIDER explicitly.
# Free tiers may use prompts for training: don't send private code to them.
AI_PROVIDER=fake
# Required for openai_compatible. Examples (pick one):
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1                          AI_MODEL=openai/gpt-oss-120b
#   Cerebras:   AI_BASE_URL=https://api.cerebras.ai/v1                              AI_MODEL=gpt-oss-120b
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1                            AI_MODEL=openai/gpt-oss-120b:free
#   Gemini:     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai AI_MODEL=gemini-2.5-flash
# The key is a secret: never commit it; the API never logs it.
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=openai/gpt-oss-120b
# Reasoning models spend output tokens thinking before they answer: keep this generous.
AI_MAX_OUTPUT_TOKENS=8000
# Analyses a workspace may start per rolling 24 hours (429 with Retry-After beyond that).
AI_MAX_JOBS_PER_WORKSPACE_PER_DAY=20
# Jobs one API instance works on at once. Free tiers have low rate limits: keep it at 1.
AI_WORKER_CONCURRENCY=1
# Timeout for one model call, in milliseconds.
AI_TIMEOUT_MS=60000
