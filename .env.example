NODE_ENV=development
# 127.0.0.1 locally; 0.0.0.0 in production so the host's proxy can reach the API.
HOST=127.0.0.1
# If unset, the API uses PORT (set by Render), then 4000. Don't set API_PORT on Render.
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000

# Local infrastructure (docker-compose.yml). Local-only placeholder values.
POSTGRES_USER=diffcraft
POSTGRES_PASSWORD=diffcraft
POSTGRES_DB=diffcraft
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://diffcraft:diffcraft@localhost:5432/diffcraft
# Maximum open Postgres connections per API instance.
DB_POOL_MAX=10
# Production only: proxy addresses to trust for X-Forwarded-For (client IPs): IPs, CIDRs or
# presets (loopback, linklocal, uniquelocal). Render's proxy connects from a private address.
TRUST_PROXY=uniquelocal
# Used only by tests (migrated automatically before the API tests run). Never point it at a real database.
TEST_DATABASE_URL=postgresql://diffcraft:diffcraft@localhost:5432/diffcraft_test
REDIS_URL=redis://localhost:6379
