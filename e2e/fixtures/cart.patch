@@ -0,0 +1,11 @@
+const CODES: Record<string, number> = {
+  WELCOME10: 0.1,
+  SPRING25: 0.25,
+};
+
+export function applyDiscount(total: number, code?: string): number {
+  if (!code) return total;
+  const rate = CODES[code.toUpperCase()];
+  if (rate === undefined) return total;
+  return Math.round(total * (1 - rate) * 100) / 100;
+}
