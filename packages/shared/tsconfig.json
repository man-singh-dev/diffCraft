{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    // For the tests and scripts; src/ itself must stay free of Node APIs.
    "types": ["node"],
    // .ts import extensions let both Bundler (Next.js) and NodeNext (API) consumers resolve shared source; needs noEmit.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "scripts"]
}
